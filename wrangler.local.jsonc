{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grow-book-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ADMIN_USERNAME": "growbook-admin",
    "ADMIN_PASSWORD": "GrowBook-local-2026!",
    "ADMIN_SESSION_SECRET": "growbook-local-session-secret-change-before-sharing",
    "ADMIN_COOKIE_SECURE": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grow-book-local",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "grow-book-local-assets"
    }
  ]
}
